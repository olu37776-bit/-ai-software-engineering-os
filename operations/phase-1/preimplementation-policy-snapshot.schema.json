{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aseos:operation-schema:phase-1-verification-policy-snapshot:1.0.0",
  "title": "Phase 1 Verification Policy Snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "policySnapshotId",
    "policySnapshotVersion",
    "sourceBaselineCommit",
    "rules",
    "decisionAlgorithm"
  ],
  "properties": {
    "$schema": {
      "const": "urn:aseos:operation-schema:phase-1-verification-policy-snapshot:1.0.0"
    },
    "schemaVersion": {
      "const": "1.0.0"
    },
    "policySnapshotId": {
      "$ref": "urn:aseos:schema:common-identifiers:1.0.0#/$defs/uuidV7"
    },
    "policySnapshotVersion": {
      "const": "1.0.0"
    },
    "sourceBaselineCommit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "decisionAlgorithm": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "implementedRequires",
        "blockingResults",
        "verifiedAuthority"
      ],
      "properties": {
        "implementedRequires": {
          "const": [
            "M0_GATE_PASS",
            "ALL_REQUIRED_VERIFICATION_STEPS_PASS",
            "ALL_NINE_SUBOPERATIONS_IMPLEMENTED",
            "ADR_0007_THROUGH_0011_OBLIGATIONS_PASS",
            "WRITE_SCOPE_COMPLIANT",
            "NO_UNAUTHORIZED_FALLBACK",
            "DOCUMENTATION_SYNCHRONIZED"
          ]
        },
        "blockingResults": {
          "const": [
            "FAIL",
            "BLOCKED",
            "UNAVAILABLE",
            "INCONCLUSIVE",
            "NOT_RUN"
          ]
        },
        "verifiedAuthority": {
          "const": "INDEPENDENT_VERIFICATION_GATE_ONLY"
        }
      }
    }
  }
}
