{
  "name": "@aseos/cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "aseos": "./dist/main.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.json --pretty false",
    "clean": "tsc -b tsconfig.json --clean",
    "typecheck": "tsc -b tsconfig.json --pretty false"
  },
  "dependencies": {
    "@aseos/platform": "workspace:*"
  },
  "engines": {
    "node": "24.19.0"
  }
}
