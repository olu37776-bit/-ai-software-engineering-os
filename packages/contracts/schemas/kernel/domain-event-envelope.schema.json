{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aseos:schema:domain-event-envelope:1.0.0",
  "title": "DomainEventEnvelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "eventId",
    "eventType",
    "aggregateType",
    "aggregateId",
    "aggregateVersion",
    "occurredAt",
    "actor",
    "causationId",
    "correlationId",
    "payloadSchema",
    "payloadHash",
    "payload"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "eventId": {
      "$ref": "urn:aseos:schema:common-identifiers:1.0.0#/$defs/uuidV7"
    },
    "eventType": {
      "$ref": "urn:aseos:schema:common-identifiers:1.0.0#/$defs/canonicalTypeName"
    },
    "aggregateType": {
      "$ref": "urn:aseos:schema:common-identifiers:1.0.0#/$defs/canonicalTypeName"
    },
    "aggregateId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "aggregateVersion": {
      "type": "integer",
      "minimum": 1
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "actor": {
      "$ref": "urn:aseos:schema:actor-ref:1.0.0"
    },
    "causationId": {
      "$ref": "urn:aseos:schema:common-identifiers:1.0.0#/$defs/uuidV7"
    },
    "correlationId": {
      "$ref": "urn:aseos:schema:common-identifiers:1.0.0#/$defs/uuidV7"
    },
    "payloadSchema": {
      "$ref": "urn:aseos:schema:schema-ref:1.0.0"
    },
    "payloadHash": {
      "$ref": "urn:aseos:schema:common-identifiers:1.0.0#/$defs/sha256"
    },
    "payload": {
      "type": "object"
    }
  }
}
