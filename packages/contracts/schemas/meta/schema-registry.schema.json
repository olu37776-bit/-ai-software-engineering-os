{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aseos:schema:schema-registry:1.0.0",
  "x-schemaVersion": "1.0.0",
  "title": "ASEOS Complete Schema Registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "registryVersion",
    "hashPolicy",
    "schemas"
  ],
  "properties": {
    "$schema": {
      "const": "urn:aseos:schema:schema-registry:1.0.0"
    },
    "registryVersion": {
      "const": "1.0.0"
    },
    "hashPolicy": {
      "const": "SHA256_EXACT_AUTHORITY_FILE_BYTES"
    },
    "schemas": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schemaId",
          "authorityPath",
          "sha256",
          "category",
          "examplesRequired"
        ],
        "properties": {
          "schemaId": {
            "type": "string",
            "format": "uri"
          },
          "authorityPath": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "$ref": "urn:aseos:schema:common-identifiers:1.0.0#/$defs/sha256"
          },
          "category": {
            "enum": [
              "RUNTIME",
              "META",
              "GOVERNANCE",
              "FIXTURE"
            ]
          },
          "examplesRequired": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
