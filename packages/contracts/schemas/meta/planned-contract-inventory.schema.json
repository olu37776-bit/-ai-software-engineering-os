{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aseos:schema:planned-contract-inventory:1.0.0",
  "title": "ASEOS Planned Contract Inventory",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "inventoryVersion",
    "baselineCommit",
    "status",
    "contracts",
    "dependencyStatus"
  ],
  "properties": {
    "$schema": {
      "const": "urn:aseos:schema:planned-contract-inventory:1.0.0"
    },
    "inventoryVersion": {
      "$ref": "urn:aseos:schema:common-identifiers:1.0.0#/$defs/semanticVersion"
    },
    "baselineCommit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "status": {
      "const": "PLANNED"
    },
    "dependencyStatus": {
      "const": "DEFERRED_UNTIL_SCHEMA_BASELINE"
    },
    "contracts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "contractId",
          "canonicalName",
          "domain",
          "canonicalOwner",
          "contractKind",
          "priority",
          "phaseIntroduced",
          "authorityPath",
          "adrRefs"
        ],
        "properties": {
          "contractId": {
            "type": "string",
            "pattern": "^aseos\\.[a-z0-9-]+(?:\\.[a-z0-9-]+)+$"
          },
          "canonicalName": {
            "$ref": "urn:aseos:schema:common-identifiers:1.0.0#/$defs/canonicalTypeName"
          },
          "domain": {
            "type": "string",
            "minLength": 1
          },
          "canonicalOwner": {
            "type": "string",
            "pattern": "^packages/[a-z0-9-]+$"
          },
          "contractKind": {
            "enum": [
              "JSON_SCHEMA",
              "OPENAPI_COMPONENT",
              "STATE_SCHEMA",
              "MANIFEST",
              "PORT_CONFORMANCE"
            ]
          },
          "priority": {
            "enum": [
              "M0",
              "P1",
              "P2",
              "P3",
              "P4"
            ]
          },
          "phaseIntroduced": {
            "pattern": "^PHASE_[0-8]$"
          },
          "authorityPath": {
            "type": "string",
            "minLength": 1
          },
          "adrRefs": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^ADR-[0-9]{4}$"
            },
            "uniqueItems": true
          }
        }
      }
    }
  }
}
