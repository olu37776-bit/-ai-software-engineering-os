{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aseos:schema:control-event-notification:1.0.0",
  "x-schemaVersion": "1.0.0",
  "title": "ControlEventNotification",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "notificationId",
    "subjectRef",
    "projectionVersion",
    "kind",
    "occurredAt",
    "resourceUri"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "notificationId": {
      "$ref": "urn:aseos:schema:common-identifiers:1.0.0#/$defs/uuidV7"
    },
    "subjectRef": { "$ref": "urn:aseos:schema:subject-ref:1.0.0" },
    "projectionVersion": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "kind": {
      "enum": ["RUNTIME_STATUS", "OPERATION_METADATA", "EVIDENCE_METADATA"]
    },
    "occurredAt": { "type": "string", "format": "date-time" },
    "resourceUri": { "type": "string", "pattern": "^/v1/", "maxLength": 1024 }
  }
}
