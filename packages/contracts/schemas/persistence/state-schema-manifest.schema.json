{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aseos:schema:state-schema-manifest:1.0.0",
  "x-schemaVersion": "1.0.0",
  "title": "StateSchemaManifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "databaseSchemaVersion",
    "migrations",
    "sqliteVersion",
    "compatibility"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "databaseSchemaVersion": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "migrations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "version",
          "name",
          "sha256"
        ],
        "properties": {
          "version": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "sha256": {
            "$ref": "urn:aseos:schema:common-identifiers:1.0.0#/$defs/sha256"
          }
        }
      }
    },
    "sqliteVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "compatibility": {
      "enum": [
        "COMPATIBLE",
        "UPGRADE_REQUIRED",
        "INCOMPATIBLE"
      ]
    }
  }
}
