{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aseos:schema:persistence-commit-receipt:1.0.0",
  "x-schemaVersion": "1.0.0",
  "title": "PersistenceCommitReceipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "transactionId",
    "commandId",
    "aggregateType",
    "aggregateId",
    "committedVersion",
    "eventIds",
    "outboxTaskIds",
    "auditIds",
    "receiptHash",
    "committedAt"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "transactionId": {
      "$ref": "urn:aseos:schema:common-identifiers:1.0.0#/$defs/uuidV7"
    },
    "commandId": {
      "$ref": "urn:aseos:schema:common-identifiers:1.0.0#/$defs/uuidV7"
    },
    "aggregateType": {
      "$ref": "urn:aseos:schema:common-identifiers:1.0.0#/$defs/canonicalTypeName"
    },
    "aggregateId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "committedVersion": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "eventIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "urn:aseos:schema:common-identifiers:1.0.0#/$defs/uuidV7"
      }
    },
    "outboxTaskIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "urn:aseos:schema:common-identifiers:1.0.0#/$defs/uuidV7"
      }
    },
    "auditIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "urn:aseos:schema:common-identifiers:1.0.0#/$defs/uuidV7"
      }
    },
    "receiptHash": {
      "$ref": "urn:aseos:schema:common-identifiers:1.0.0#/$defs/sha256"
    },
    "committedAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
