{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aseos:schema:journal-append-batch:1.0.0",
  "x-schemaVersion": "1.0.0",
  "title": "JournalAppendBatch",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "transactionId",
    "commandId",
    "idempotencyKey",
    "effectScope",
    "payloadHash",
    "stream",
    "events",
    "outbox",
    "audit",
    "capturedAt"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "transactionId": {
      "$ref": "urn:aseos:schema:common-identifiers:1.0.0#/$defs/uuidV7"
    },
    "commandId": {
      "$ref": "urn:aseos:schema:common-identifiers:1.0.0#/$defs/uuidV7"
    },
    "idempotencyKey": {
      "$ref": "urn:aseos:schema:common-identifiers:1.0.0#/$defs/idempotencyKey"
    },
    "effectScope": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "payloadHash": {
      "$ref": "urn:aseos:schema:common-identifiers:1.0.0#/$defs/sha256"
    },
    "stream": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "aggregateType",
        "aggregateId",
        "expectedVersion"
      ],
      "properties": {
        "aggregateType": {
          "$ref": "urn:aseos:schema:common-identifiers:1.0.0#/$defs/canonicalTypeName"
        },
        "aggregateId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "expectedVersion": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "$ref": "urn:aseos:schema:domain-event-envelope:1.0.0"
      }
    },
    "outbox": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "$ref": "urn:aseos:schema:side-effect-task-envelope:1.0.0"
      }
    },
    "audit": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "auditId",
          "occurredAt",
          "action",
          "payloadHash"
        ],
        "properties": {
          "auditId": {
            "$ref": "urn:aseos:schema:common-identifiers:1.0.0#/$defs/uuidV7"
          },
          "occurredAt": {
            "type": "string",
            "format": "date-time"
          },
          "action": {
            "$ref": "urn:aseos:schema:common-identifiers:1.0.0#/$defs/stableCode"
          },
          "payloadHash": {
            "$ref": "urn:aseos:schema:common-identifiers:1.0.0#/$defs/sha256"
          }
        }
      }
    },
    "capturedAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
