{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aseos:schema:outbox-record:1.0.0",
  "x-schemaVersion": "1.0.0",
  "title": "OutboxRecord",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "taskId",
    "idempotencyKey",
    "effectScope",
    "payloadHash",
    "status",
    "attempt",
    "createdAt",
    "leasedUntil"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "taskId": {
      "$ref": "urn:aseos:schema:common-identifiers:1.0.0#/$defs/uuidV7"
    },
    "idempotencyKey": {
      "$ref": "urn:aseos:schema:common-identifiers:1.0.0#/$defs/idempotencyKey"
    },
    "effectScope": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "payloadHash": {
      "$ref": "urn:aseos:schema:common-identifiers:1.0.0#/$defs/sha256"
    },
    "status": {
      "enum": [
        "PENDING",
        "DISPATCHED",
        "FAILED"
      ]
    },
    "attempt": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "leasedUntil": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    }
  }
}
