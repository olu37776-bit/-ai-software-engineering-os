{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aseos:schema:projection-checkpoint:1.0.0",
  "x-schemaVersion": "1.0.0",
  "title": "ProjectionCheckpoint",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "projectionName",
    "projectionVersion",
    "sourceSequence",
    "rebuiltFromSequence",
    "updatedAt"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "projectionName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "projectionVersion": {
      "$ref": "urn:aseos:schema:common-identifiers:1.0.0#/$defs/semanticVersion"
    },
    "sourceSequence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "rebuiltFromSequence": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
