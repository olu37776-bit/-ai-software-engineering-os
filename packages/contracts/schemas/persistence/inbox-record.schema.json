{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aseos:schema:inbox-record:1.0.0",
  "x-schemaVersion": "1.0.0",
  "title": "InboxRecord",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "resultId",
    "taskId",
    "payloadHash",
    "status",
    "receivedAt"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "resultId": {
      "$ref": "urn:aseos:schema:common-identifiers:1.0.0#/$defs/uuidV7"
    },
    "taskId": {
      "$ref": "urn:aseos:schema:common-identifiers:1.0.0#/$defs/uuidV7"
    },
    "payloadHash": {
      "$ref": "urn:aseos:schema:common-identifiers:1.0.0#/$defs/sha256"
    },
    "status": {
      "enum": [
        "ACCEPTED",
        "DUPLICATE",
        "REJECTED"
      ]
    },
    "receivedAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
